{
  "appId": "com.orbit.app",
  "productName": "Orbit",
  "electronVersion": "33.2.0",
  "directories": {
    "output": "../../dist-installer"
  },
  "files": [
    "main.cjs",
    "server-bundle.cjs",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true
  }
}
